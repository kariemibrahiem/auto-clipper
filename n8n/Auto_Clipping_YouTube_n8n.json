          }
        ]
      ]
    },
    "Unzip Clips": {
      "main": [
        [
          {
            "node": "Prepare MP4 Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare MP4 Items": {
      "main": [
        [
          {
            "node": "Upload Shorts to YouTube",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Shorts to YouTube": {
      "main": [
        [
          {
            "node": "YouTube Links",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
