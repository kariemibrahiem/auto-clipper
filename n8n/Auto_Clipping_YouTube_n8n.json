{
  "name": "Auto Clipping | GitHub FFmpeg + Narration + YouTube Shorts",
  "nodes": [
    {
      "id": "auto-clip-1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "parameters": {}
    },
    {
      "id": "auto-clip-2",
      "name": "Configure Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        410,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ONLY EDIT THESE VALUES BEFORE EXECUTING.\nconst SOURCE_VIDEO_URL = 'PASTE_HTTPS_VIDEO_LINK_HERE';\nconst GITHUB_REPO = 'kariemibrahiem/auto-clipper';\nconst VIDEO_TITLE = 'Best Moments';\nconst CLIP_COUNT = 3;               // 1 to 5\nconst CLIP_SECONDS = 35;            // 15 to 55\nconst LANGUAGE = 'auto';            // 'auto', 'ar', 'en'\nconst NARRATION = 'on';             // 'on' or 'off'\n\nif (!/^https:\\/\\//i.test(SOURCE_VIDEO_URL))\n  throw new Error('Paste the HTTPS video URL in Configure Job first.');\nif (!/^[a-zA-Z0-9_.-]+\\/[a-zA-Z0-9_.-]+$/.test(GITHUB_REPO))\n  throw new Error('GITHUB_REPO must look like username/auto-clipper.');\nif (CLIP_COUNT < 1 || CLIP_COUNT > 5 || CLIP_SECONDS < 15 || CLIP_SECONDS > 55)\n  throw new Error('Allowed: 1–5 clips of 15–55 seconds.');\nconst job_id = Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8);\nreturn [{json:{source_url:SOURCE_VIDEO_URL, repo:GITHUB_REPO,\n  job_id, run_label:'clip-' + job_id, base_title:VIDEO_TITLE,\n  clip_count:CLIP_COUNT, clip_seconds:CLIP_SECONDS,\n  language:LANGUAGE, narration:NARRATION, started_at:Date.now()}}];"
      }
    },
    {
      "id": "auto-clip-3",
      "name": "Dispatch GitHub Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        635,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://api.github.com/repos/\" + $json.repo + \"/actions/workflows/clipper.yml/dispatches\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ref:'main',inputs:{job_id:$json.job_id,\n    source_url:$json.source_url,clip_count:String($json.clip_count),\n    clip_seconds:String($json.clip_seconds),language:$json.language,\n    narration:$json.narration}}) }}"
      },
      "alwaysOutputData": true
    },
    {
      "id": "auto-clip-4",
      "name": "Wait for GitHub",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        850,
        300
      ],
      "parameters": {
        "amount": 30
      }
    },
    {
      "id": "auto-clip-5",
      "name": "List Clip Runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://api.github.com/repos/\" + $(\"Configure Job\").first().json.repo + \"/actions/workflows/clipper.yml/runs?event=workflow_dispatch&per_page=100\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "auto-clip-6",
      "name": "Find This Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Configure Job').first().json;\nconst obj = $input.first().json;\nconst runs = Array.isArray(obj.workflow_runs) ? obj.workflow_runs : [];\nconst run = runs.find(r => r.display_title === cfg.run_label);\nif (Date.now() - cfg.started_at > 105 * 60 * 1000)\n  throw new Error('Clipping timed out. Open GitHub Actions for details.');\nif (run?.status === 'completed' && run.conclusion !== 'success')\n  throw new Error('GitHub clip rendering failed: ' + run.html_url);\nreturn [{json:{ready:run?.status === 'completed' && run.conclusion === 'success',\n  github_run_id:run?.id || null, github_run_url:run?.html_url || '',\n  job_id:cfg.job_id}}];"
      }
    },
    {
      "id": "auto-clip-7",
      "name": "Clips Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1460,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "clip-ready-condition",
              "leftValue": "={{ String($json.ready) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "auto-clip-8",
      "name": "List Run Artifacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1690,
        250
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://api.github.com/repos/\" + $(\"Configure Job\").first().json.repo + \"/actions/runs/\" + $json.github_run_id + \"/artifacts?per_page=50\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "auto-clip-9",
      "name": "Find Clips ZIP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1890,
        250
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Configure Job').first().json;\nconst data = $input.first().json;\nconst name = 'clips-' + cfg.job_id;\nconst artifact = (data.artifacts || []).find(a => a.name === name && !a.expired);\nif (!artifact?.archive_download_url)\n  throw new Error('No clip artifact found for ' + name);\nreturn [{json:{archive_download_url:artifact.archive_download_url}}];"
      }
    },
    {
      "id": "auto-clip-10",
      "name": "Download Clips ZIP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2090,
        250
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.archive_download_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "id": "auto-clip-11",
      "name": "Unzip Clips",
      "type": "n8n-nodes-base.compression",
      "typeVersion": 1.1,
      "position": [
        2290,
        250
      ],
      "parameters": {
        "outputPrefix": "extracted_"
      }
    },
    {
      "id": "auto-clip-12",
      "name": "Prepare MP4 Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        250
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Configure Job').first().json;\nconst output = [];\nconst items = $input.all();\nfor (const item of items) {\n  for (const [key, binary] of Object.entries(item.binary || {})) {\n    const filename = binary.fileName || '';\n    if (!/\\.mp4$/i.test(filename) && binary.mimeType !== 'video/mp4') continue;\n    const found = filename.match(/clip_(\\d+)\\.mp4$/i);\n    if (!found) throw new Error('Unknown MP4 filename: ' + filename);\n    const number = Number(found[1]);\n    const base = cfg.base_title.trim() || 'Best Moments';\n    const title = (base + ' | Part ' + number + ' #Shorts').slice(0, 99);\n    output.push({json:{clip_number:number, title,\n      description:'Highlight ' + number + ' from an authorized source. #Shorts #Highlights',\n      original_source:cfg.source_url, job_id:cfg.job_id},\n      binary:{data:binary}});\n  }\n}\noutput.sort((a,b) => a.json.clip_number-b.json.clip_number);\nif (!output.length) throw new Error('ZIP contains no MP4 clips.');\nreturn output;"
      }
    },
    {
      "id": "auto-clip-13",
      "name": "Upload Shorts to YouTube",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        2700,
        250
      ],
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $json.title }}",
        "regionCode": "EG",
        "categoryId": "24",
        "options": {
          "description": "={{ $json.description }}",
          "privacyStatus": "public",
          "tags": "Shorts,Highlights,Clips"
        }
      },
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "1pwrEJLIkJE2vaFF",
          "name": "YouTube account"
        }
      }
    },
    {
      "id": "auto-clip-14",
      "name": "YouTube Links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2910,
        250
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const uploaded = $input.all();\nconst clips = $('Prepare MP4 Items').all();\nreturn uploaded.map((item, i) => {\n  const id = item.json.uploadId || item.json.id || item.json.videoId || item.json.data?.id;\n  if (!id || typeof id !== 'string')\n    throw new Error('YouTube did not confirm video ID for clip ' + (i + 1));\n  return {json:{clip_number:clips[i]?.json.clip_number ?? i + 1,\n    title:clips[i]?.json.title || 'Short',\n    url:'https://www.youtube.com/shorts/' + id,\n    uploadId:id}};\n});"
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Configure Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configure Job": {
      "main": [
        [
          {
            "node": "Dispatch GitHub Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch GitHub Job": {
      "main": [
        [
          {
            "node": "Wait for GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for GitHub": {
      "main": [
        [
          {
            "node": "List Clip Runs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Clip Runs": {
      "main": [
        [
          {
            "node": "Find This Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find This Job": {
      "main": [
        [
          {
            "node": "Clips Ready?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clips Ready?": {
      "main": [
        [
          {
            "node": "List Run Artifacts",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Run Artifacts": {
      "main": [
        [
          {
            "node": "Find Clips ZIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Clips ZIP": {
      "main": [
        [
          {
            "node": "Download Clips ZIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Clips ZIP": {
      "main": [
        [
          {
