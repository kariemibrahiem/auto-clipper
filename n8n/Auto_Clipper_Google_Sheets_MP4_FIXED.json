    {
      "id": "abbd991c-26b8-4c2e-ab6c-9efa007a880f",
      "name": "Pick Next Pending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One job per execution. source_url can be a direct MP4; optional media_url\n// may point to a licensed MP4 when source_url is a YouTube watch page.\nconst rows = $input.all();\nconst next = rows.find(item => {\n  const row = item.json || {};\n  const status = String(row.status || '').trim().toLowerCase();\n  return String(row.source_url || '').trim() && (!status || status === 'pending');\n});\nif (!next) return [];\nconst row = next.json;\nconst source_url = String(row.source_url).trim();\nconst media_url = String(row.media_url || '').trim();\nconst actual_url = media_url || source_url;\nconst job_id = Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 9);\nconst bounded = (raw, fallback, min, max) => {\n  const n = Number(raw);\n  return raw === '' || raw === null || raw === undefined || !Number.isInteger(n) || n < min || n > max ? fallback : n;\n};\nconst language = ['auto','ar','en'].includes(String(row.language || '').trim().toLowerCase()) ? String(row.language).trim().toLowerCase() : 'auto';\nconst narration = ['on','off'].includes(String(row.narration || '').trim().toLowerCase()) ? String(row.narration).trim().toLowerCase() : 'on';\nconst checkUrl = value => {\n  try {\n    const u = new URL(value);\n    return u.protocol === 'https:' && !!u.hostname && !u.username && !u.password;\n  } catch { return false; }\n};\nconst isYoutube = /^(www\\.|m\\.)?(youtube\\.com|youtu\\.be)$/i.test((() => {try{return new URL(source_url).hostname;}catch{return '';}})());\nconst noDownloadableVideo = isYoutube && !media_url;\nconst invalid_input = !checkUrl(source_url) || !checkUrl(actual_url) || noDownloadableVideo;\nconst reason = !checkUrl(source_url) || !checkUrl(actual_url)\n  ? 'source_url / media_url must be valid public HTTPS URLs'\n  : noDownloadableVideo\n    ? 'GitHub is blocked by YouTube bot verification. Use a licensed direct MP4 in source_url, or add media_url with a direct downloadable MP4.'\n    : '';\nconst start_seconds = bounded(row.start_seconds,0,0,10799);\nconst analysis_seconds = bounded(row.analysis_seconds,1800,60,2700);\nreturn [{json:{\n  row_number:Number(row.row_number), source_url, media_url, download_url:actual_url,\n  repo:'kariemibrahiem/auto-clipper',\n  job_id, run_label:'clip-' + job_id,\n  base_title:String(row.title || 'Best Moments').trim() || 'Best Moments',\n  clip_count:bounded(row.clip_count,3,1,5),\n  clip_seconds:bounded(row.clip_seconds,35,15,55),\n  language,narration,started_at:Date.now(), start_seconds, analysis_seconds,\n  source_is_direct: Boolean(media_url) || /\\.(mp4|mov|mkv|webm|m4v)(\\?|$)/i.test(actual_url),\n  invalid_input, error:reason\n}}];"
      }
    },
