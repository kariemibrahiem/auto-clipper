      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Configure Job').first().json;\nconst runs = $input.first().json.workflow_runs || [];\nconst run = Array.isArray(runs) ? runs.find(r => r.display_title === cfg.run_label) : null;\nconst timedOut = Date.now() - cfg.started_at > 105 * 60 * 1000;\nconst failed = timedOut || (run?.status === 'completed' && run.conclusion !== 'success');\nconst ready = !failed && run?.status === 'completed' && run.conclusion === 'success';\nconst reason = timedOut ? 'GitHub rendering timed out after 105 minutes' :\n  (failed ? 'GitHub rendering failed: ' + (run?.html_url || 'Check GitHub Actions logs') : '');\nreturn [{json:{ready:!!ready, failed:!!failed, error:reason,\n  github_run_id:run?.id || null, github_run_url:run?.html_url || '',job_id:cfg.job_id}}];"
      }
    },
